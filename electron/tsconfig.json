{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "noEmit": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noImplicitReturns": true,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
