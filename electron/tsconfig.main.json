{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "outDir": "dist-main",
    "rootDir": "src",
    "sourceMap": true,
    "incremental": true,
    "tsBuildInfoFile": "dist-main/.tsbuildinfo"
  },
  "include": ["src/main", "src/shared"],
  "exclude": ["**/*.test.ts", "**/*.test.mts", "**/*.test.cts"]
}
